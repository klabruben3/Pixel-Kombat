{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\g++\\g++ 14.2\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
            
                // Includes
                "-I",
                "${workspaceFolder}/include",
                "-I",
                "${workspaceFolder}/extern/SFML/include",
            
                // cpp files
                "${workspaceFolder}/src/*.cpp",
            
                // Linking
                "-L",
                "${workspaceFolder}/extern/SFML/lib",
                "-lsfml-graphics-d",
                "-lsfml-window-d",
                "-lsfml-system-d",
            
                // Output
                "-o",
                "${workspaceFolder}/bin/pixel_kombat.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }

    ],
    "version": "2.0.0"
}